# ==============================================================================
# CINEVERSE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Run: cp .env.example .env (or copy on Windows)
# DO NOT commit your real '.env' file to Git!
# ==============================================================================

# TMDB (The Movie Database) API v3 Key
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# (Optional) Allowed Frontend Origins for CORS (comma-separated)
# Defaults to localhost and private network IPs
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001

# (Optional) Admin Key for protecting POST /api/streams endpoint
ADMIN_API_KEY=change_this_to_a_secure_admin_secret
